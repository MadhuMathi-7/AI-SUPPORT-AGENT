# Environment configuration for Hiver AI Customer Support Agent

# Optional LLM API keys (e.g. for LLM-as-judge and reply generation)
# Supports OpenAI, Anthropic, or local open-weights / fallback simulators
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Random seed for reproducibility
RANDOM_SEED=42

# Execution environment: dev, test, prod
ENVIRONMENT=dev
